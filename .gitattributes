* text=auto eol=lf

*.md diff=markdown
*.php diff=php

# Dev-only tooling: not needed by a consumer who just requires the
# package. contract/VERSION is deliberately NOT export-ignored —
# EcollectorsCloud::contractVersion() reads it at runtime from the
# installed package root, so it must ship in every distributed release.
/.github export-ignore
/bin export-ignore
/generator export-ignore
/tests export-ignore
/contract/openapi.yaml export-ignore
/docs/snippets.json export-ignore
/phpunit.xml export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.editorconfig export-ignore
