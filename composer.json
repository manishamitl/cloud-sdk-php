{
    "name": "ecollectors/cloud-sdk",
    "description": "Official PHP/Laravel SDK for the eCollectors Cloud API (M6.2) — generated models and Requests, hand-maintained facade.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/ecollectors/cloud-sdk-php",
    "support": {
        "issues": "https://github.com/ecollectors/cloud-sdk-php/issues",
        "source": "https://github.com/ecollectors/cloud-sdk-php",
        "docs": "https://docs.ecollectors.cloud"
    },
    "keywords": ["ecollectors", "sdk", "api-client", "openapi", "laravel", "saloon"],
    "require": {
        "php": "^8.1",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Ecollectors\\CloudSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ecollectors\\CloudSdk\\Generator\\": "generator/",
            "Ecollectors\\CloudSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "generate": "php bin/generate",
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
